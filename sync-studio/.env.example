# Public site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://syncstudio.ma

# WhatsApp number in international format, digits only (e.g. 2126XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact form email (sent with Resend: https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@syncstudio.ma
CONTACT_FROM_EMAIL=Sync Studio <hello@syncstudio.ma>

# Analytics (off by default). Example for Plausible:
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
# NEXT_PUBLIC_ANALYTICS_DOMAIN=syncstudio.ma
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
