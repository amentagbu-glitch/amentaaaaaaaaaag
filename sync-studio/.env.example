# Public site URL (used for SEO, sitemap, Open Graph).
# Leave empty on Netlify until you own the domain: the Netlify address is used automatically.
NEXT_PUBLIC_SITE_URL=

# Optional: WhatsApp number override, digits only (default 212614686769 in lib/site.ts)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact form email (sent with Resend: https://resend.com)
# Before your domain is verified in Resend, use the test sender below and set
# CONTACT_TO_EMAIL to the email you signed up to Resend with (the only address it can deliver to).
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@syncstudio.ma
CONTACT_FROM_EMAIL=Sync Studio <hello@syncstudio.ma>
# CONTACT_FROM_EMAIL=Sync Studio <onboarding@resend.dev>

# Analytics (off by default). Example for Plausible:
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
# NEXT_PUBLIC_ANALYTICS_DOMAIN=syncstudio.ma
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
